{
  "name": "catalogo-digital-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test tests/e2e/public-catalog.spec.js --workers=1",
    "test:e2e:report": "playwright show-report",
    "test:permissions": "node --test tests/permissions.test.js",
    "lighthouse": "lighthouse http://localhost:4173 --output html --output-path ./lighthouse-report.html --chrome-flags=\"--headless\"",
    "lighthouse:pwa": "lighthouse http://localhost:4173/catalogo --preset=perf --only-categories=performance,accessibility,best-practices,seo --output html --output-path ./lighthouse-report.html --chrome-flags=\"--headless\"",
    "quality:lighthouse": "npm run build && node scripts/run-lighthouse-audit.mjs",
    "axe": "axe http://localhost:4173"
  },
  "dependencies": {
    "@fontsource/fredoka-one": "^5.2.5",
    "@fontsource/nunito": "^5.2.7",
    "@supabase/supabase-js": "^2.98.0",
    "fuse.js": "^7.3.0",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1"
  },
  "overrides": {
    "ws": "^8.21.0",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.1",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "lighthouse": "^13.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "terser": "^5.46.2",
    "vite": "^7.3.1",
    "vite-plugin-html": "^3.2.2"
  }
}
