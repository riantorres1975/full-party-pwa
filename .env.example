# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env y rellena tus credenciales.
# Encuéntralas en: Supabase Dashboard → Settings → API
#
# SEGURIDAD: La anon key es pública por diseño (Row-Level Security protege los datos).
# Rótala periódicamente en: Supabase Dashboard → Settings → API → Regenerate anon key
# Si la rotas, actualiza este archivo y redepliega.
# ─────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Configuración del Negocio
VITE_WHATSAPP_NUMBER="521XXXXXXXXXX"
VITE_NOMBRE_NEGOCIO="Tu Negocio"
VITE_HORARIO_TIENDA="Lun–Sáb 9am–7pm"
VITE_SITE_URL="https://www.fullpartyuruapan.com.mx"
VITE_MONEDA="MXN"

# ── Sucursal 1 ────────────────────────────────────────────────
VITE_SUC1_NOMBRE="Nombre de la calle/colonia"
VITE_SUC1_BADGE="Sucursal Centro"
VITE_SUC1_DIRECCION="Tu dirección completa"
VITE_SUC1_MAPS_URL="https://maps.google.com/..."
VITE_SUC1_FACEBOOK="https://www.facebook.com/..."

# ── Sucursal 2 ───────────────────────────────────────────────
VITE_SUC2_NOMBRE="Nombre de la calle/colonia"
VITE_SUC2_BADGE="Sucursal Principal"
VITE_SUC2_DIRECCION="Tu dirección completa"
VITE_SUC2_MAPS_URL="https://maps.google.com/..."
VITE_SUC2_FACEBOOK="https://www.facebook.com/..."

# Seguridad: lista de emails autorizados como admin (separados por coma)
# IMPORTANTE: Si se deja vacío, TODOS los usuarios autenticados tendrán acceso admin.
VITE_ADMIN_EMAILS="admin@tutienda.com"

# Redes sociales (deja vacío para ocultar el botón)
VITE_TIKTOK_URL=""
